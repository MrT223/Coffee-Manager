# --- Database ---
DB_HOST=db
DB_PORT=5432
DB_NAME=coffee_db
DB_USER=postgres
DB_PASSWORD=your_strong_password_here

# --- Security & JWT ---
SECRET_KEY=your_random_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# --- SMTP Email (tuỳ chọn) ---
