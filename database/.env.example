# ============================================================
# Database Configuration
# Copy file nay thanh .env va dien thong tin cua ban
# cp .env.example .env
# ============================================================

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coffee_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Hoac dung full connection string (uu tien hon cac bien tren)
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/coffee_db

# SMTP Email Configuration (UC-13)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-demo-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_SENDER=Coffee Manager System <your-demo-email@gmail.com>
ADMIN_EMAIL=admin-receiver-email@gmail.com